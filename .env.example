# Copy to .env and adjust. Every value has a working default for local use, so this file is optional.
# Never commit .env; it is git-ignored.

# --- Server ---
PORT=3000
LOG_LEVEL=info
# true when behind a load balancer such as AWS ALB, so rate limiting sees the client IP
TRUST_PROXY=false

# --- Product data source ---
# Which adapter supplies products (src/catalogue/productSourceFactory.ts)
PRODUCT_SOURCE=fakestore
FAKE_STORE_BASE_URL=https://fakestoreapi.com
FAKE_STORE_TIMEOUT_MS=5000
CATALOGUE_CACHE_TTL_SECONDS=300
# Fake Store prices carry no currency, so it is configured (ISO 4217)
CATALOGUE_CURRENCY=AUD

# --- Merchandising ---
# The five products the business has chosen to feature on the home page, in display order.
# Leave empty (FEATURED_PRODUCT_IDS=) to show the top 5 by weighted rating (stars + number of reviews) instead.
FEATURED_PRODUCT_IDS=11,12,3,18,5
# How many products a category page shows as "top rated" before the rest
CATEGORY_TOP_RATED_COUNT=3
# Reviews needed before a product's own average counts half (weighted rating). Stops a 5.0 from
# a single review outranking 4.8 from hundreds. 0 = plain average.
RATING_PRIOR_WEIGHT=25

# --- Enquiry email ---
SALES_INBOX_EMAIL=sales@example.com
EMAIL_FROM=Product Catalogue <no-reply@example.com>
# smtp (default; Mailpit locally, Amazon SES in production) or log (prints emails, no SMTP needed).
# Running the backend WITHOUT Docker and without Mailpit? Set this to log, or enquiries will fail.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
